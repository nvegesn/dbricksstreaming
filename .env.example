# ==============================================================================
# Confluent Cloud & Databricks Community Edition Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual Confluent Cloud credentials.
# Do NOT commit your real .env file with secrets to Git!

# 1. Confluent Cloud Kafka Cluster
# Found in: Confluent Cloud > Cluster Settings > Identification > Bootstrap server
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_TOPIC=starbucks_live_orders

# 2. Confluent Cloud Cluster API Key & Secret
# Generated in: Confluent Cloud > API Keys > Add Key > Cluster
KAFKA_API_KEY=YOUR_CONFLUENT_CLUSTER_API_KEY
KAFKA_API_SECRET=YOUR_CONFLUENT_CLUSTER_API_SECRET

# 3. Confluent Cloud Schema Registry
# Found in: Confluent Cloud > Stream Governance / Schema Registry > Endpoint
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud

# 4. Schema Registry API Key & Secret
# Generated in: Confluent Cloud > Stream Governance > API Keys > Add Key > Schema Registry
SCHEMA_REGISTRY_API_KEY=YOUR_SCHEMA_REGISTRY_API_KEY
SCHEMA_REGISTRY_API_SECRET=YOUR_SCHEMA_REGISTRY_API_SECRET

# 5. Schema ID (Optional: simulator will auto-fetch from Schema Registry if left blank)
# SCHEMA_ID=100001
